; Committed .npmrc - points npm at the public Harness Artifact Registry for
; relicx-playwright-sdk. No auth token is needed because the registry's
; visibility is Public.
;
; All other packages (@playwright/test, axios, jest, ...) are resolved through
; the same registry, which means the AR must be configured to proxy
; registry.npmjs.org as an upstream. In Harness UI:
;   Artifact Registry -> relicx-playwright-sdk -> Configuration
;   -> Advanced (Optional) -> Configure Upstream -> add registry.npmjs.org

registry=https://harness0.harness.io/pkg/l7B_kbSEQD2wjrM7PShm5w/relicx-playwright-sdk/npm/
